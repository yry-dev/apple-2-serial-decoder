{
  "name": "apple2gs-serial",
  "version": "1.0.0",
  "description": "Apple II GS Serial Number Decoder - Decode serial numbers to find factory, year, week, unit number, and owner information",
  "main": "dist/app.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve-dist": "cd dist && python3 -m http.server 8000",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.15.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "vite": "^7.1.3"
  },
  "keywords": [
    "apple",
    "apple2gs",
    "serial",
    "decoder",
    "vintage",
    "computer",
    "vue",
    "typescript",
    "tailwind"
  ],
  "author": "",
  "license": "MIT"
}
